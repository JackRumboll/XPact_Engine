# XPact Engine .gitignore

# Cache & intermediates (generated by XBT + XHT + compile)
Engine/Cache/
**/Intermediate/
**/Saved/

# Generated VS / IDE project files
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.sln
*.suo
*.user

# Generated XPact build artifacts
Engine/Binaries/
**/obj/
**/bin/
*.pdb
*.ilk
*.exp
*.lib.recipe
*.tlog

# XHT-generated headers / .gen.cpp / bindings.json (regenerated by XBT)
**/Generated/
**/*.generated.h
**/*.gen.cpp
xht-input-manifest.json
bindings.json

# .NET build artifacts
**/bin/
**/obj/
*.dll
*.exe
*.pdb

# OS junk
Thumbs.db
.DS_Store
desktop.ini

# Editor / IDE state
.vs/
.vscode/
.idea/
*.swp
*~

# C# generated source-gen outputs
**/Generated_*.g.cs
