<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Simgenics.XPact.XBT.Entry</RootNamespace>
    <AssemblyName>XBT</AssemblyName>
    <OutputType>Exe</OutputType>
    <RootDocumentation>true</RootDocumentation>
    <Description>XBT executable: CLI dispatcher and mode registry. The Build mode is a stub at Phase 1; build orchestration lands in Phase 1.2.</Description>

    <!--
      Release-time single-file publish properties. PublishSingleFile and
      SelfContained are only honored at `dotnet publish` time, not at
      `dotnet build`. The properties are declared here so a release pipeline
      can publish without further configuration.
    -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!--
      RuntimeIdentifier is intentionally NOT set in the csproj per the
      Toolchain Contract envelope. The publish RID is picked at the
      publish command line so the same source tree publishes for Win64,
      Linux, and Android-host-x86_64 deterministically.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XBT.Core\XBT.Core.csproj" />
    <ProjectReference Include="..\XBT.Manifest\XBT.Manifest.csproj" />
    <!--
      Phase 1.3 additions: project-file generation mode pulls in the
      configuration / discovery / toolchain / project-files layers so
      GenerateProjectFilesMode can compose its GenerationContext. Per
      /Documents/XBT.html Rev 4 Section 14.
    -->
    <ProjectReference Include="..\XBT.Configuration\XBT.Configuration.csproj" />
    <ProjectReference Include="..\XBT.Discovery\XBT.Discovery.csproj" />
    <ProjectReference Include="..\XBT.ActionGraph\XBT.ActionGraph.csproj" />
    <ProjectReference Include="..\XBT.Toolchain\XBT.Toolchain.csproj" />
    <ProjectReference Include="..\XBT.ProjectFiles\XBT.ProjectFiles.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      XBT.Tests needs access to BuildMode internals for the
      hello-world smoke test (BuildMode is run programmatically, not
      by spawning the xbt.exe).
    -->
    <InternalsVisibleTo Include="XBT.Tests" />
  </ItemGroup>

</Project>
