<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Simgenics.XPact.XBT.Discovery</RootNamespace>
    <AssemblyName>XBT.Discovery</AssemblyName>
    <Description>Plugin and module discovery for XBT. Walks /Engine/, /Studio/, /Projects/ trees for .xplugin and .Build.toml files; applies shadow precedence (Project shadows Studio shadows Engine) per Toolchain Contract Rev 13 Section 9.4; records all observed plugin descriptors so cache invalidation tracks shadow changes (Rev 2 audit finding #8). Per /Documents/XBT.html Rev 4 Section 17.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XBT.Core\XBT.Core.csproj" />
    <ProjectReference Include="..\XBT.Configuration\XBT.Configuration.csproj" />
    <ProjectReference Include="..\XBT.Manifest\XBT.Manifest.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="XBT.Tests" />
  </ItemGroup>

</Project>
