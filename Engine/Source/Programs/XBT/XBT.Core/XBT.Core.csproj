<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Simgenics.XPact.XBT.Core</RootNamespace>
    <AssemblyName>XBT.Core</AssemblyName>
    <Description>XBT primitives: IoHash (BLAKE3), FileItem, structured logging, cancellation extensions. No build semantics.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      BLAKE3 NuGet package per /Documents/XBT.html Section 15.5:
      "XBT uses BLAKE3 as its content-hash algorithm for all three cache
      layers." Stable 1.x line.
    -->
    <PackageReference Include="Blake3" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      XBT.Tests needs access to internal test hooks on Logger
      (__SetJsonStreamForTesting, __ResetWarningLatchForTesting) and on
      RepoRoot (ResetForTesting, SetForTesting, DiscoverFrom) per
      /Documents/XBT.html Rev 4 Section 22.1 deterministic-input rule.
      Keep this list short; new entries must justify why a test cannot
      exercise the surface through the public API.
    -->
    <InternalsVisibleTo Include="XBT.Tests" />
  </ItemGroup>

</Project>
