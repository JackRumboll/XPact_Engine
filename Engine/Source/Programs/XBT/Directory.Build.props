<Project>

  <!--
    Shared MSBuild properties for every XBT project (XBT.Core, XBT.Manifest,
    XBT.Entry, and XBT.Tests added by subagent B).

    Per /Documents/XBT.html Rev 4 Section 2 and the Toolchain Contract
    Rev 13: XBT is a .NET 8 standalone tool. Deterministic builds are
    locked engine-wide; warnings-as-errors is mandatory at the project
    level; C# 12 is the locked language version.

    This file is automatically imported by MSBuild from every .csproj
    inside this directory tree. It must not import anything outside
    /Engine/Source/Programs/XBT/.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      Reproducibility envelope per Toolchain Contract Rev 13 Section 2.1.
      Deterministic compilation + embedded sources guarantees byte-identical
      output across two clean builds on the same machine.
    -->
    <Deterministic>true</Deterministic>
    <EmbedAllSources>true</EmbedAllSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <DebugType>portable</DebugType>

    <!--
      Allow running with a newer .NET runtime (we target net8.0 but the
      host machine may only have .NET 9+). Mirrors Unreal Engine's
      RollForward pattern at UnrealEngine.csproj.props.
    -->
    <RollForward>LatestMajor</RollForward>

    <!--
      Suppress generated AssemblyAttributes that record machine-local
      paths; those would break deterministic output.
    -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Copyright>Copyright Simgenics. All Rights Reserved.</Copyright>
    <Company>Simgenics</Company>
    <Product>XPact Build Tool</Product>

    <!--
      We bake all manifest/contract type DTOs by hand for now. Source
      generators are explicitly disabled by the Toolchain Contract
      (XIL2CPP does not host Roslyn analyzers in MVP). The setting
      below stops the SDK from emitting analyzer references the build
      could otherwise pick up.
    -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

</Project>
