<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Simgenics.XPact.XBT.Toolchain</RootNamespace>
    <AssemblyName>XBT.Toolchain</AssemblyName>
    <Description>Toolchain abstraction layer for XBT. Owns XToolChain (abstract base), XMSVCToolChain (Win64), XClangToolChain (Linux + Android), per-platform flag translation tables (FPSemantics, OptimizeCodeMode, SimdLevel, SimPath determinism flag set per Toolchain Contract Rev 13 Section 4.2), and the reproducibility envelope per XBT.html Section 19.1.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XBT.Core\XBT.Core.csproj" />
    <ProjectReference Include="..\XBT.Manifest\XBT.Manifest.csproj" />
    <ProjectReference Include="..\XBT.ActionGraph\XBT.ActionGraph.csproj" />
    <ProjectReference Include="..\XBT.Configuration\XBT.Configuration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="XBT.Tests" />
  </ItemGroup>

</Project>
