<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Simgenics.XPact.XHT.Core</RootNamespace>
    <AssemblyName>XHT.Core</AssemblyName>
    <Description>XHT primitives: FileItems, BLAKE3 content-hashing, atomic IO with pinned temp-file naming, sorted-set utilities, structured logging helpers, streaming JSON channel writer. No knowledge of reflection or build semantics. Per /Documents/XHT.html Rev 5 Section 2.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Test hooks (Logger.__SetStderrForTesting, etc.) are internal so
      production callers don't see them. XHT.Tests needs access for the
      stderr-capture-without-rebinding Console.Error pattern (mirrors
      XBT.Core's InternalsVisibleTo entry).
    -->
    <InternalsVisibleTo Include="XHT.Tests" />
  </ItemGroup>

</Project>
