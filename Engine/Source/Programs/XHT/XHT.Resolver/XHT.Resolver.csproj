<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Simgenics.XPact.XHT.Resolver</RootNamespace>
    <AssemblyName>XHT.Resolver</AssemblyName>
    <Description>Seven-active-phase symbol-resolution pipeline (None &#8594; Pairings &#8594; InvalidCheck &#8594; BindSuperAndBases &#8594; ResolveBases &#8594; Properties &#8594; RecursiveStructCheck &#8594; Final) plus symbol-table population pass and validator pass. Per /Documents/XHT.html Rev 7 Section 5 and Section 6.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XHT.Core\XHT.Core.csproj" />
    <ProjectReference Include="..\XHT.AST\XHT.AST.csproj" />
    <ProjectReference Include="..\XHT.Tables\XHT.Tables.csproj" />
    <ProjectReference Include="..\XHT.Manifest\XHT.Manifest.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Internal helpers (e.g. container-type extraction in
         StepResolveProperties) are exposed to the XHT.Tests project so
         the C4-audit tests can exercise them directly. -->
    <InternalsVisibleTo Include="XHT.Tests" />
  </ItemGroup>

</Project>
