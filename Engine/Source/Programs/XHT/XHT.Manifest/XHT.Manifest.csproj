<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Simgenics.XPact.XHT.Manifest</RootNamespace>
    <AssemblyName>XHT.Manifest</AssemblyName>
    <Description>Reads the JSON + FlatBuffers manifest XBT emits (Toolchain Contract Section 10.2). Prefers the FBS binary sidecar via FlatSharp; falls back to JSON. Does not depend on XBT.Manifest at runtime &#8212; the schema is shared by reference. Per /Documents/XHT.html Rev 8 Section 2 and Section 25.2 item 2.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XHT.Core\XHT.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Round 7 R6-XH1: ManifestMalformedException's no-code constructors
      are internal so production callers cannot construct an un-anchored
      exception (which would surface as XHT900 ICE per
      XHT.Entry.Program). The test assembly needs access to validate the
      XHT900 ICE branch in Program.Main still fires the expected stderr.
    -->
    <InternalsVisibleTo Include="XHT.Tests" />
  </ItemGroup>

</Project>
